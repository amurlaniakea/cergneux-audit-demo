    given-names: "Pedro"
    alias: "MagoPredator"
repository-code: "https://github.com/amurlaniakea/cergneux-audit-demo"
url: "https://github.com/amurlaniakea/cergneux-audit-demo"
license: AGPL-3.0-or-later
version: 0.2.1
date-released: 2026-11-10
keywords:
